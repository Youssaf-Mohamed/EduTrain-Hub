@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access Denied";
}

<section class="auth-card auth-card-small animate-in">
    <div class="auth-logo mx-auto mb-3"><i class="bi bi-shield-x"></i></div>
    <div class="auth-heading text-center">
        <h1>Access denied</h1>
        <p>Your account does not have permission to open this workspace.</p>
    </div>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-grid-1x2"></i> Dashboard
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </form>
    </div>
</section>
