@model Windows_Programing.ViewModels.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<section class="auth-card animate-in">
    <div class="auth-brand">
        <div class="auth-logo"><i class="bi bi-mortarboard-fill"></i></div>
        <div>
            <span>TrainMS</span>
            <small>Secure Training Management</small>
        </div>
    </div>

    <div class="auth-heading">
        <h1>Sign in</h1>
        <p>Use your administrator account to access the management console.</p>
    </div>

    <form asp-action="Login" method="post" class="auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" placeholder="admin@trainms.local" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" placeholder="Enter password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 justify-content-center py-2">
            <i class="bi bi-shield-lock"></i> Sign in securely
        </button>
    </form>

    <div class="auth-demo">
        <strong>Default admin</strong>
        <span>admin@trainms.local / Admin@12345</span>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
