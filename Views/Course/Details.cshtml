@model Windows_Programing.Models.Course
@{
    ViewData["Title"] = "Course Details";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn-back-distinct">
        <i class="bi bi-arrow-left-short"></i> Back
    </a>
    <h1 class="fw-700 mb-0" style="font-size:1.5rem;">
        <i class="bi bi-book me-2 text-primary"></i>Course Details
    </h1>
</div>

<div class="row g-4 animate-in">
    <div class="col-lg-5">
        <div class="card detail-card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i> Course Metrics
            </div>
            <div class="card-body">
                <div class="detail-row">
                    <span class="detail-label">Course Name</span>
                    <span class="detail-value fw-600">@Model.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Training Hours</span>
                    <span class="detail-value"><i class="bi bi-clock me-1 text-muted"></i>@Model.Hours hrs</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Total Weight</span>
                    <span class="detail-value fw-600">@Model.Degree points</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Passing Minimum</span>
                    <span class="detail-value fw-600 text-danger">@Model.MinDegree points</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Department</span>
                    <span class="detail-value">@(Model.Department?.Name ?? "Unassigned")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-person-workspace text-success"></i> Instructors (@Model.Instructors.Count)
            </div>
            @if (!Model.Instructors.Any())
            {
                <div class="card-body py-4 text-center">
                    <span class="text-muted small">No instructors assigned to this course.</span>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var ins in Model.Instructors)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person-circle me-2 text-muted"></i>@ins.Name</span>
                            <span class="badge bg-light text-muted border">@(ins.Department?.Name ?? "General")</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-person-check text-primary"></i> Trainee Outcomes (@Model.CourseResults.Count)
            </div>
            @if (!Model.CourseResults.Any())
            {
                <div class="card-body py-4 text-center">
                    <span class="text-muted small">No results recorded for this course.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Trainee</th>
                                <th>Score</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model.CourseResults)
                            {
                                bool isPassed = res.Degree >= Model.MinDegree;
                                <tr>
                                    <td>
                                        <i class="bi bi-person me-2 text-muted"></i>@(res.Trainee?.Name ?? "Trainee")
                                    </td>
                                    <td class="fw-600">@res.Degree / @Model.Degree</td>
                                    <td>
                                        @if (isPassed)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: .75rem;">
                                                <i class="bi bi-check-circle me-1"></i>Passed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size: .75rem;">
                                                <i class="bi bi-x-circle me-1"></i>Failed
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white">
        <i class="bi bi-pencil"></i> Edit Course
    </a>
    <a asp-action="Index" class="btn-back-distinct">
        <i class="bi bi-list-ul"></i> All Courses
    </a>
</div>
