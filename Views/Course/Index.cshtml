@model IEnumerable<Windows_Programing.Models.Course>
@{
    ViewData["Title"] = "Courses";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-700 mb-1" style="font-size:1.6rem;"><i class="bi bi-book me-2 text-primary"></i>Courses</h1>
        <p class="text-muted mb-0" style="font-size:.875rem;">Manage academic courses, training hours, and grade configurations.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Course
    </a>
</div>

<div class="table-container animate-in">
    <div class="table-toolbar">
        <h5><i class="bi bi-list-ul me-2 text-muted"></i>All Courses <span class="badge bg-primary ms-1">@Model.Count()</span></h5>
        <form asp-action="Index" method="get" class="search-bar">
            <i class="bi bi-search search-icon"></i>
            <input type="search" name="search" value="@search" class="form-control" placeholder="Search course or department..." />
        </form>
    </div>
    
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-book" style="font-size:3rem;color:#cbd5e1;"></i>
            <p class="text-muted mt-3">No courses found. @(string.IsNullOrWhiteSpace(search) ? "Create the first one." : "Try another search term.")</p>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Search</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Course Name</th>
                        <th>Duration</th>
                        <th>Total Degree</th>
                        <th>Passing Limit</th>
                        <th>Department</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-600">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#fffbeb;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-journal-bookmark text-warning" style="font-size:.85rem;"></i>
                                    </div>
                                    <span>@c.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-clock me-1"></i>@c.Hours Hrs
                                </span>
                            </td>
                            <td>
                                <span class="fw-600">@c.Degree pts</span>
                            </td>
                            <td>
                                <span class="fw-600 text-danger">@c.MinDegree pts</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-muted border">
                                    <i class="bi bi-building me-1"></i>@(c.Department?.Name ?? "General")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-action-details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-action-edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-action-delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
