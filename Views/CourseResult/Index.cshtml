@model IEnumerable<Windows_Programing.Models.CourseResult>
@{
    ViewData["Title"] = "Course Results";
    var search = ViewData["Search"] as string;
    var status = ViewData["Status"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-700 mb-1" style="font-size:1.6rem;"><i class="bi bi-award me-2 text-primary"></i>Course Results</h1>
        <p class="text-muted mb-0" style="font-size:.875rem;">Manage and view grades for all trainees across courses.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Record Grade
    </a>
</div>

<div class="table-container animate-in">
    <div class="table-toolbar">
        <h5><i class="bi bi-list-ul me-2 text-muted"></i>All Results <span class="badge bg-primary ms-1">@Model.Count()</span></h5>
        <form asp-action="Index" method="get" class="d-flex flex-column flex-md-row gap-2 align-items-stretch align-items-md-center">
            <div class="search-bar">
                <i class="bi bi-search search-icon"></i>
                <input type="search" name="search" value="@search" class="form-control" placeholder="Search trainee or course..." />
            </div>
            <select name="status" class="form-select filter-select" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrWhiteSpace(status) ? "selected" : null)">All Statuses</option>
                <option value="passed" selected="@(status == "passed" ? "selected" : null)">Passed</option>
                <option value="failed" selected="@(status == "failed" ? "selected" : null)">Failed</option>
            </select>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-award" style="font-size:3rem;color:#cbd5e1;"></i>
            <p class="text-muted mt-3">No grades found. @(string.IsNullOrWhiteSpace(search) && string.IsNullOrWhiteSpace(status) ? "Record the first grade." : "Try adjusting the filters.")</p>
            @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Trainee</th>
                        <th>Course</th>
                        <th>Score Achieved</th>
                        <th>Passing Limit</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in Model)
                    {
                        bool isPassed = res.Course != null && res.Degree >= res.Course.MinDegree;
                        <tr>
                            <td class="fw-600">
                                <i class="bi bi-person me-2 text-muted"></i>@(res.Trainee?.Name ?? "N/A")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-journal-text me-1"></i>@(res.Course?.Name ?? "N/A")
                                </span>
                            </td>
                            <td>
                                <span class="fw-600">@res.Degree pts</span>
                            </td>
                            <td class="text-muted">
                                @(res.Course?.MinDegree ?? 0) / @(res.Course?.Degree ?? 100) pts
                            </td>
                            <td>
                                @if (isPassed)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: .75rem;">
                                        <i class="bi bi-check-circle me-1"></i>Passed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size: .75rem;">
                                        <i class="bi bi-x-circle me-1"></i>Failed
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@res.Id" class="btn btn-sm btn-action-details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@res.Id" class="btn btn-sm btn-action-edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@res.Id" class="btn btn-sm btn-action-delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
