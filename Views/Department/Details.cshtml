@model Windows_Programing.Models.Department
@{
    ViewData["Title"] = "Department Details";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn-back-distinct">
        <i class="bi bi-arrow-left-short"></i> Back
    </a>
    <h1 class="fw-700 mb-0" style="font-size:1.5rem;">
        <i class="bi bi-building me-2 text-primary"></i>Department Details
    </h1>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card detail-card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i> Department Info
            </div>
            <div class="card-body">
                <div class="detail-row">
                    <span class="detail-label">ID</span>
                    <span class="detail-value text-muted">#@Model.Id</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Name</span>
                    <span class="detail-value fw-600">@Model.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Manager</span>
                    <span class="detail-value">
                        <i class="bi bi-person-badge me-1 text-muted"></i>@Model.Manager
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Instructors</span>
                    <span class="detail-value">
                        <span class="badge bg-primary">@Model.Instructors.Count</span>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Courses</span>
                    <span class="detail-value">
                        <span class="badge bg-warning text-dark">@Model.Courses.Count</span>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Trainees</span>
                    <span class="detail-value">
                        <span class="badge bg-success">@Model.Trainees.Count</span>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        @if (Model.Instructors.Any())
        {
            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-person-workspace me-2 text-success"></i>Instructors (@Model.Instructors.Count)</div>
                <ul class="list-group list-group-flush">
                    @foreach (var ins in Model.Instructors)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person-circle me-2 text-muted"></i>@ins.Name</span>
                            <span class="text-muted" style="font-size:.8rem;">EGP @ins.Salary.ToString("N0")</span>
                        </li>
                    }
                </ul>
            </div>
        }
        @if (Model.Courses.Any())
        {
            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-book me-2 text-warning"></i>Courses (@Model.Courses.Count)</div>
                <ul class="list-group list-group-flush">
                    @foreach (var c in Model.Courses)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-journal me-2 text-muted"></i>@c.Name</span>
                            <span class="badge bg-light text-dark border">@c.Hours hrs</span>
                        </li>
                    }
                </ul>
            </div>
        }
        @if (Model.Trainees.Any())
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-people me-2 text-primary"></i>Trainees (@Model.Trainees.Count)</div>
                <ul class="list-group list-group-flush">
                    @foreach (var t in Model.Trainees)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person me-2 text-muted"></i>@t.Name</span>
                            <span class="badge bg-light text-dark border">@t.Grade</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white">
        <i class="bi bi-pencil"></i> Edit
    </a>
    <a asp-action="Index" class="btn-back-distinct">
        <i class="bi bi-list-ul"></i> All Departments
    </a>
</div>
