@model IEnumerable<Windows_Programing.Models.Department>
@{
    ViewData["Title"] = "Departments";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-700 mb-1" style="font-size:1.6rem;"><i class="bi bi-building me-2 text-primary"></i>Departments</h1>
        <p class="text-muted mb-0" style="font-size:.875rem;">Manage all departments and their managers.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Department
    </a>
</div>

<div class="table-container animate-in">
    <div class="table-toolbar">
        <h5><i class="bi bi-list-ul me-2 text-muted"></i>All Departments <span class="badge bg-primary ms-1">@Model.Count()</span></h5>
        <form asp-action="Index" method="get" class="search-bar">
            <i class="bi bi-search search-icon"></i>
            <input type="search" name="search" value="@search" class="form-control" placeholder="Search department or manager..." />
        </form>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-building" style="font-size:3rem;color:#cbd5e1;"></i>
            <p class="text-muted mt-3">No departments found. @(string.IsNullOrWhiteSpace(search) ? "Add the first one." : "Try another search term.")</p>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Search</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Department Name</th>
                        <th>Manager</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td class="text-muted fw-600">@dept.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#eff6ff;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-building text-primary" style="font-size:.85rem;"></i>
                                    </div>
                                    <span class="fw-600">@dept.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="d-flex align-items-center gap-1">
                                    <i class="bi bi-person text-muted"></i> @dept.Manager
                                </span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@dept.Id" class="btn btn-sm btn-action-details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-action-edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@dept.Id" class="btn btn-sm btn-action-delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
