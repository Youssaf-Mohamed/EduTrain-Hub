@model Windows_Programing.Models.Instructor
@{
    ViewData["Title"] = "New Instructor";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn-back-distinct">
        <i class="bi bi-arrow-left-short"></i> Back
    </a>
    <h1 class="fw-700 mb-0" style="font-size:1.5rem;">
        <i class="bi bi-person-workspace me-2 text-primary"></i>Create Instructor
    </h1>
</div>

<div class="form-wrapper animate-in mx-auto">
    <h5 class="fw-700 mb-3 text-dark border-bottom pb-2">
        <i class="bi bi-info-circle me-1 text-primary"></i>Personal & Academic Details
    </h5>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: .85rem;"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. John Doe" />
            <span asp-validation-for="Name" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Salary" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">EGP</span>
                    <input asp-for="Salary" type="number" step="0.01" class="form-control" placeholder="e.g. 15000" />
                </div>
                <span asp-validation-for="Salary" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" placeholder="e.g. Heliopolis, Cairo" />
                <span asp-validation-for="Address" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Dept_Id" class="form-label">Department</label>
                <select asp-for="Dept_Id" class="form-select" asp-items="ViewBag.Dept_Id">
                    <option value="">-- Select Department --</option>
                </select>
                <span asp-validation-for="Dept_Id" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Crs_Id" class="form-label">Course to Teach</label>
                <select asp-for="Crs_Id" class="form-select" asp-items="ViewBag.Crs_Id">
                    <option value="">-- Select Course --</option>
                </select>
                <span asp-validation-for="Crs_Id" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
            </div>
        </div>

        <div class="mb-4">
            <label for="imageFile" class="form-label">Profile Image</label>
            <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*" />
            <span class="text-muted" style="font-size: .75rem;">Optional. JPG, PNG, or GIF format.</span>
        </div>

        <div class="d-flex gap-2 justify-content-end border-top pt-3">
            <a asp-action="Index" class="btn-back-distinct">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Save Instructor
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
