@model Windows_Programing.Models.Instructor
@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn-back-distinct">
        <i class="bi bi-arrow-left-short"></i> Back
    </a>
    <h1 class="fw-700 mb-0" style="font-size:1.5rem;">
        <i class="bi bi-person-workspace me-2 text-primary"></i>Edit Instructor
    </h1>
</div>

<div class="form-wrapper animate-in mx-auto">
    <h5 class="fw-700 mb-3 text-dark border-bottom pb-2">
        <i class="bi bi-pencil-square me-1 text-warning"></i>Update Instructor Information
    </h5>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: .85rem;"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Image" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Salary" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">EGP</span>
                    <input asp-for="Salary" type="number" step="0.01" class="form-control" />
                </div>
                <span asp-validation-for="Salary" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Dept_Id" class="form-label">Department</label>
                <select asp-for="Dept_Id" class="form-select" asp-items="ViewBag.Dept_Id"></select>
                <span asp-validation-for="Dept_Id" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Crs_Id" class="form-label">Course to Teach</label>
                <select asp-for="Crs_Id" class="form-select" asp-items="ViewBag.Crs_Id"></select>
                <span asp-validation-for="Crs_Id" class="text-danger mt-1 d-block" style="font-size: .8rem;"></span>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label d-block">Current Profile Photo</label>
            <div class="d-flex align-items-center gap-3 mb-3">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="~/images/uploads/@Model.Image" class="profile-image-lg" alt="@Model.Name" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=&quot;avatar-placeholder&quot; style=&quot;width:100px;height:100px;font-size:2rem;&quot;>@Model.Name[0]</div>';" />
                }
                else
                {
                    <div class="avatar-placeholder" style="width: 100px; height: 100px; font-size: 2rem;">
                        @Model.Name[0]
                    </div>
                }
                <div>
                    <label for="imageFile" class="btn btn-sm btn-outline-primary mb-1">
                        <i class="bi bi-upload"></i> Change Photo
                    </label>
                    <input type="file" id="imageFile" name="imageFile" class="d-none" accept="image/*" onchange="document.getElementById('file-chosen-label').innerText = this.files[0].name;" />
                    <span id="file-chosen-label" class="text-muted d-block" style="font-size: .75rem;">No new file chosen.</span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end border-top pt-3">
            <a asp-action="Index" class="btn-back-distinct">Cancel</a>
            <button type="submit" class="btn btn-warning text-white">
                <i class="bi bi-save"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
