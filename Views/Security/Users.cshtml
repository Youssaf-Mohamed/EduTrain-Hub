@model Windows_Programing.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-800 mb-1" style="font-size:1.6rem;"><i class="bi bi-person-lock me-2 text-primary"></i>Users</h1>
        <p class="text-muted mb-0" style="font-size:.875rem;">Manage sign-in accounts, roles, and account status.</p>
    </div>
    <a asp-action="CreateUser" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> New User
    </a>
</div>

<div class="table-container animate-in">
    <div class="table-toolbar">
        <h5><i class="bi bi-shield-lock me-2 text-muted"></i>Security Accounts <span class="badge bg-primary ms-1">@Model.Users.Count</span></h5>
        <a asp-action="Roles" class="btn btn-sm btn-action-details">
            <i class="bi bi-sliders"></i> Role Permissions
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-placeholder">@user.FullName[0]</div>
                                <div>
                                    <div class="fw-700">@user.FullName</div>
                                    <div class="text-muted-sm">@user.Email</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-primary-light text-primary">@user.Role?.Name</span></td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Disabled</span>
                            }
                        </td>
                        <td class="text-muted">@(user.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                        <td>
                            <div class="d-flex justify-content-end">
                                <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-action-edit">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
