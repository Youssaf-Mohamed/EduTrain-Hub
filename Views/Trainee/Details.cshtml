@model Windows_Programing.Models.Trainee
@{
    ViewData["Title"] = "Trainee Details";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn-back-distinct">
        <i class="bi bi-arrow-left-short"></i> Back
    </a>
    <h1 class="fw-700 mb-0" style="font-size:1.5rem;">
        <i class="bi bi-people me-2 text-primary"></i>Trainee Details
    </h1>
</div>

<div class="row g-4 animate-in">
    <div class="col-md-4 text-center">
        <div class="card p-4 h-100 d-flex flex-column align-items-center justify-content-center">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="~/images/uploads/@Model.Image" class="profile-image-lg mb-3" alt="@Model.Name" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=&quot;avatar-placeholder mx-auto mb-3&quot; style=&quot;width:100px;height:100px;font-size:2rem;&quot;>@Model.Name[0]</div>';" />
            }
            else
            {
                <div class="avatar-placeholder mx-auto mb-3" style="width: 100px; height: 100px; font-size: 2rem;">
                    @Model.Name[0]
                </div>
            }
            <h4 class="fw-700 text-dark mb-1">@Model.Name</h4>
            <p class="text-muted mb-3">Grade: @Model.Grade</p>
            <span class="badge bg-primary">@(Model.Department?.Name ?? "General Department")</span>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card detail-card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i> Personal Details
            </div>
            <div class="card-body">
                <div class="detail-row">
                    <span class="detail-label">Full Name</span>
                    <span class="detail-value fw-600">@Model.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Address</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(Model.Address) ? "Not Specified" : Model.Address)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Department</span>
                    <span class="detail-value">@(Model.Department?.Name ?? "Unassigned")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Enrolled Courses</span>
                    <span class="detail-value">
                        <span class="badge bg-primary">@Model.CourseResults.Count</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-award text-success"></i> Academic Performance & Results
            </div>
            @if (!Model.CourseResults.Any())
            {
                <div class="card-body py-4 text-center">
                    <span class="text-muted small">No course outcomes recorded for this trainee.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th>Score Achieved</th>
                                <th>Passing Grade</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model.CourseResults)
                            {
                                bool isPassed = res.Degree >= (res.Course?.MinDegree ?? 0);
                                <tr>
                                    <td class="fw-600">@(res.Course?.Name ?? "Course")</td>
                                    <td>@res.Degree / @(res.Course?.Degree ?? 100)</td>
                                    <td class="text-muted">@(res.Course?.MinDegree ?? 0)</td>
                                    <td>
                                        @if (isPassed)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: .75rem;">
                                                <i class="bi bi-check-circle me-1"></i>Passed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size: .75rem;">
                                                <i class="bi bi-x-circle me-1"></i>Failed
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white">
        <i class="bi bi-pencil"></i> Edit Details
    </a>
    <a asp-action="Index" class="btn-back-distinct">
        <i class="bi bi-list-ul"></i> All Trainees
    </a>
</div>
