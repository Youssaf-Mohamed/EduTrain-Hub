@model IEnumerable<Windows_Programing.Models.Trainee>
@{
    ViewData["Title"] = "Trainees";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-700 mb-1" style="font-size:1.6rem;"><i class="bi bi-people me-2 text-primary"></i>Trainees</h1>
        <p class="text-muted mb-0" style="font-size:.875rem;">Manage students and trainees enrolled in your training tracks.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Trainee
    </a>
</div>

<div class="table-container animate-in">
    <div class="table-toolbar">
        <h5><i class="bi bi-list-ul me-2 text-muted"></i>All Trainees <span class="badge bg-primary ms-1">@Model.Count()</span></h5>
        <form asp-action="Index" method="get" class="search-bar">
            <i class="bi bi-search search-icon"></i>
            <input type="search" name="search" value="@search" class="form-control" placeholder="Search name, grade, address..." />
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-people" style="font-size:3rem;color:#cbd5e1;"></i>
            <p class="text-muted mt-3">No trainees found. @(string.IsNullOrWhiteSpace(search) ? "Register the first trainee." : "Try another search term.")</p>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Search</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Grade / Level</th>
                        <th>Address</th>
                        <th>Department</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(t.Image))
                                {
                                    <img src="~/images/uploads/@t.Image" class="profile-image" alt="@t.Name" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=&quot;avatar-placeholder&quot;>@t.Name[0]</div>';" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder">@t.Name[0]</div>
                                }
                            </td>
                            <td class="fw-600">@t.Name</td>
                            <td>
                                <span class="badge bg-primary-light text-primary border-0">
                                    <i class="bi bi-award me-1"></i>@t.Grade
                                </span>
                            </td>
                            <td class="text-muted">@(string.IsNullOrEmpty(t.Address) ? "N/A" : t.Address)</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-building me-1"></i>@(t.Department?.Name ?? "General")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-action-details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-action-edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-action-delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
